# ===================================================================
# Telegram Bot Configuration Template & AWS Environment Properties
# Official Maintainer: @No_MOORESINPS
# Official Telegram Bot: https://t.me/chessvideosbot (@chessvideosbot)
# ===================================================================

# [REQUIRED] Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=

# [REQUIRED] Telegram Bot Token from @BotFather
BOT_TOKEN=

# [AWS CLOUD INFRASTRUCTURE & PERSISTENCE]
# AWS Region (e.g. ap-south-1, us-east-1)
AWS_DEFAULT_REGION=ap-south-1

# Amazon DynamoDB Table Name for user settings & session records
DYNAMODB_TABLE_NAME=tg_users

# Enable AWS DynamoDB (Set to True; falls back gracefully to SQLite database/bot.db if unavailable)
USE_DYNAMODB=True

# AWS IAM Credentials (Optional when running on Amazon EC2 / ECS with attached IAM Role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Amazon S3 Bucket Name (Optional; direct disk-to-Telegram streaming used for zero-cost operation)
S3_BUCKET_NAME=

# [ADMIN] Telegram Admin Username / User ID
ADMINS=No_MOORESINPS

# [PORT] Web Health Check Port (AWS Elastic Beanstalk uses 5000)
PORT=5000

# [OPTIONAL] Forward all downloaded content to a specific channel ID (e.g. -1001234567890)
CHANNEL_ID=

# [LOGIN SYSTEM] True enables interactive /login command via phone OTP in Telegram
LOGIN_SYSTEM=True

# [SESSION] Only required if LOGIN_SYSTEM=False
STRING_SESSION=

# [RATE LIMITING] Anti-flood delay in seconds between download/upload requests
WAITING_TIME=10

# [NOTIFICATIONS] Display detailed error message in chat if transfer fails
ERROR_MESSAGE=True

# [YOUTUBE] Optional Netscape cookies text to bypass age restrictions or bot checks
YOUTUBE_COOKIES=
