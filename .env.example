# ===================================================================
# Telegram Bot Configuration Template & AWS Environment Properties
# Official Maintainer: @No_MOORESINPS
# Official Telegram Bot: https://t.me/chessvideosbot (@chessvideosbot)
# ===================================================================

# [REQUIRED] Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=

# [REQUIRED] Telegram Bot Token from @BotFather
BOT_TOKEN=

# [REQUIRED FOR AWS/PRODUCTION] MongoDB Atlas connection string (or DB_URI)
# Format: mongodb+srv://<username>:<password>@cluster0.pmci032.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
DB_NAME=sih26044
USERS_COLLECTION=tg_users
BATCH_TASKS_COLLECTION=tg_batch_tasks

# [ADMIN] Telegram Admin Username / User ID
ADMINS=No_MOORESINPS

# [PORT] Web Health Check Port (AWS Elastic Beanstalk uses 5000)
PORT=5000

# [OPTIONAL] Forward all downloaded content to a specific channel ID (e.g. -1001234567890)
CHANNEL_ID=

# [LOGIN SYSTEM] True enables interactive /login command via QR or phone OTP in Telegram
LOGIN_SYSTEM=True

# [SESSION] Only required if LOGIN_SYSTEM=False
STRING_SESSION=

# [RATE LIMITING] Anti-flood delay in seconds between download/upload requests
WAITING_TIME=10

# [NOTIFICATIONS] Display detailed error message in chat if transfer fails
ERROR_MESSAGE=True
