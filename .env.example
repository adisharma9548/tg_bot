# ===================================================================
# Telegram Bot Configuration Template
# ===================================================================

# Required: Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=

# Required: Telegram Bot Token from @BotFather
BOT_TOKEN=

# Optional: Admin Telegram User ID for broadcasts (leave blank if no admin)
ADMINS=

# Optional: Channel ID to forward downloaded content to (leave blank to send directly to user)
CHANNEL_ID=

# Login feature: True enables /login directly inside the bot
LOGIN_SYSTEM=True

# String Session: Only required if LOGIN_SYSTEM=False
STRING_SESSION=

# Database: MongoDB Atlas connection string (or DB_URI)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.mongodb.net/?retryWrites=true&w=majority
DB_NAME=telegram_bot

# Anti-flood delay in seconds between download/upload requests
WAITING_TIME=10

# Show error message in chat if download fails
ERROR_MESSAGE=True
