# AWS Elastic Beanstalk Configuration
# Proprietary build maintained by @No_MOORESINPS
# Official Telegram Bot: https://t.me/chessvideosbot (@chessvideosbot)

option_settings:
  aws:elasticbeanstalk:application:environment:
    PORT: "5000"
    PYTHONUNBUFFERED: "1"
    LOGIN_SYSTEM: "True"
    WAITING_TIME: "10"
    ERROR_MESSAGE: "True"
  aws:elasticbeanstalk:environment:process:default:
    Port: '5000'
    HealthCheckPath: "/health"
    HealthCheckInterval: '15'
    HealthCheckTimeout: '5'
    HealthyThresholdCount: '2'
    UnhealthyThresholdCount: '5'

commands:
  01_install_ffmpeg:
    command: |
      if ! command -v ffmpeg &> /dev/null; then
        echo "Installing ffmpeg..."
        curl -s -L https://johnvansickle.com/ffmpeg/releases/ffmpeg-release-amd64-static.tar.xz -o /tmp/ffmpeg.tar.xz || true
        if [ -f /tmp/ffmpeg.tar.xz ]; then
          mkdir -p /tmp/ffmpeg-build
          tar -xf /tmp/ffmpeg.tar.xz -C /tmp/ffmpeg-build --strip-components=1
          cp /tmp/ffmpeg-build/ffmpeg /usr/local/bin/
          cp /tmp/ffmpeg-build/ffprobe /usr/local/bin/
          chmod +x /usr/local/bin/ffmpeg /usr/local/bin/ffprobe
          rm -rf /tmp/ffmpeg*
        fi
      fi
    ignoreErrors: true
